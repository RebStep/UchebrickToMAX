# Токен Бота
MAX_BOT_TOKEN=
# Пароль базы и ключ для входа на сайт
POSTGRES_PASSWORD=
SESSION_SECRET=
# Режим: local - на своём компьютере, prod - на сервере с доменом
COMPOSE_PROFILES=local
PUBLIC_URL=http://localhost:8080
# Апи ключ для парсера заданий gigachat
GIGACHAT_CREDENTIALS=
# Модель распознавания голоса (Whisper ставится сам вместе с Docker): base, small или medium. По умолчанию small
WHISPER_MODEL=small




# ТОЛЬКО ДЛЯ СЕРВЕРА
DOMAIN=
WEBHOOK_URL=
WEBHOOK_SECRET=

ALICE_SECRET=